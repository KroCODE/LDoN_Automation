| ldon.mac - LDoN adventure loop for the Triune emu server
| AUTO-PROGRESS / AUTHORITATIVE-STATS VERSION:
|   Reads the in-game Adventure Stats window and completes each theme to 10 wins:
|   SRO (Deepest Guk) -> EP (Miragul) -> EC (Rujarkian) -> NRO (Takish) -> BM (Mistmoore) -> STOP
| Usage: /mac ldon [skip|resume]
|   skip:   already have an adventure but are still outside the dungeon; do not request another on the first loop.
|   resume: already zoned INSIDE the current adventure; immediately resume clearing it.
|
| The macro hails each camp recruiter once when that camp becomes current before
| requesting its first adventure. This is harmless if the character already unlocked it.
| Camp changes use Bazaar OR direct EC tunnel arrival -> East Commonlands as the travel hub; Magus Zeir then ports to SRO, Everfrost, NRO, or Butcherblock.
| EC itself stays in East Commonlands. Every zone the loop passes through needs a navmesh.
| Zone crossings are built in (see Sub BuiltInRoute).

#turbo 40
#event AdvWon "#*#You have successfully completed your adventure#*#"
#event Slain  "#*#You have been slain#*#"

Sub Main(string a1, string a2)
    | ================= GENERAL CONFIG =================
    | Optional safety check: put a character name here and the macro will only
    | run on that character. Leave it empty to run on any character.
    /declare CharName     string outer

    | Adventure window dropdowns, counting from the top (1 = first entry)
    /declare RiskIndex    int    outer 2
    /declare TypeIndex    int    outer 3

    | Triune auto combat puller
    /declare PullerModeCmd   string outer /ac puller
    /declare PullerOnCmd     string outer /ac run
    | stops chasing new mobs but keeps fighting what's already on me
    /declare PullerManualCmd string outer /ac manual
    | only sent once combat is completely over
    /declare PullerOffCmd    string outer /ac stop
    /declare MaxClearTime string outer 90m

    | "Bazaar and Back" AA, and the map switch in the Bazaar
    /declare BazaarAAID   int    outer 331
    /declare MapY         float  outer -646.5
    /declare MapX         float  outer 2.9
    /declare MapZ         float  outer 4.8
    /declare MapSwitchID  int    outer 146
    | ==================================================

    | Per-camp settings, filled in by SetCamp below
    /declare CampZone     string outer
    /declare QuestNPC     string outer
    /declare HasCampSpot  bool   outer FALSE
    /declare CampY        float  outer 0
    /declare CampX        float  outer 0
    /declare CampZ        float  outer 0
    /declare Ent1Zone     string outer
    /declare Ent1Path     string outer none
    /declare Ent1Y        float  outer 0
    /declare Ent1X        float  outer 0
    /declare Ent1Z        string outer none
    /declare Ent1Door     int    outer 0
    /declare MagusSay     string outer none
    /declare MagusName    string outer Magus
    /declare HasMagusExit bool   outer FALSE
    /declare MagusExitY   float  outer 0
    /declare MagusExitX   float  outer 0
    /declare Ent2Names    string outer none
    /declare Ent2Zone     string outer
    /declare Ent2Path     string outer none
    /declare Ent2Y        float  outer 0
    /declare Ent2X        float  outer 0
    /declare Ent2Z        string outer none
    /declare Ent2Door     int    outer 0
    /declare MapContinent int    outer 0
    /declare MapWaypoint  string outer none
    /declare MapRow       int    outer 0
    /declare LandZone     string outer
    /declare ReturnPath   string outer none
    /declare RetMagusSay  string outer none
    /declare RetMagusName string outer Magus

    | Route data, filled in by LoadRoute
    /declare PathFile string outer ldon_paths.ini
    /declare RP[300]  string outer
    /declare RCount   int    outer 0
    /declare RZoned   int    outer 0
    /declare RZone    string outer none
    /declare RHeading float  outer 0
    /declare RLastZ   string outer NONE
    /declare RBuiltIn bool   outer FALSE
    /declare Camp     string outer sro
    /declare SkipGet  bool   outer FALSE
    /declare ResumeDungeon bool outer FALSE
    /declare UseEnt2  bool   outer FALSE
    /declare AdvWon   bool   outer FALSE
    /declare Missing  int    outer 0
    /declare Runs       int  outer 0
    /declare RunsInCamp int  outer 0
    /declare SRODone    int  outer 0
    /declare EPDone     int  outer 0
    /declare ECDone     int  outer 0
    /declare NRODone    int  outer 0
    /declare BMDone     int  outer 0
    /declare NeedRecruiterHail bool outer TRUE

    | Startup recovery arguments:
    |   skip   = mission already accepted, but character is still outside the instance.
    |   resume = character is already INSIDE the active mission instance.
    /if (${Defined[a1]}) {
        /if (${a1.Length} && ${a1.NotEqual[NULL]}) {
            /if (${a1.Equal[skip]}) /varset SkipGet TRUE
            /if (${a1.Equal[resume]}) /varset ResumeDungeon TRUE
        }
    }
    /if (${Defined[a2]}) {
        /if (${a2.Length} && ${a2.NotEqual[NULL]}) {
            /if (${a2.Equal[skip]}) /varset SkipGet TRUE
            /if (${a2.Equal[resume]}) /varset ResumeDungeon TRUE
        }
    }

    | Read the real character totals and choose the first camp in the required order
    | that has fewer than 10 successful adventures.
    /call ReadAdventureStats
    /call SelectCampFromStats
    /call SetCamp

    | ---------- startup checks ----------
    /if (${CharName.Length}) {
        /if (${Me.Name.NotEqual[${CharName}]}) {
            /echo This macro is set up for ${CharName}. Ending.
            /endmacro
        }
    }
    /if (${MapWaypoint.Equal[none]}) {
        /echo The return trip for camp [${Camp}] isn't set up yet (map waypoint, landing zone, path back). Ending.
        /endmacro
    }
    | with a Magus shortcut the run to the entrance is only a fallback, so don't require its routes
    /if (${MagusSay.Equal[none]}) /call CheckPath ${CampZone} ${Ent1Path}
    /if (${Ent2Names.NotEqual[none]}) /call CheckPath ${CampZone} ${Ent2Path}
    /call CheckPath ${LandZone} ${ReturnPath}
    /if (${Missing}) {
        /echo ${Missing} zone crossing(s) missing for camp [${Camp}]. Ending.
        /endmacro
    }
    /echo Running camp [${Camp}] with recruiter ${QuestNPC}. Current SUCCESS count: ${RunsInCamp}/10.

    | ---------- recovery: macro restarted while already inside an adventure ----------
    | Do not try to get another mission, travel to an entrance, or click a dungeon door.
    | Just restart TAC, finish this instance, return to camp, then continue normally.
    /if (${ResumeDungeon}) {
        /echo RESUME mode: assuming ${Zone.ShortName} is the currently active LDoN instance.
        /echo Resuming the existing adventure now -- no recruiter request or entrance travel will be attempted.
        /varset ResumeDungeon FALSE
        /call ClearDungeon
        | Resume mode uses the same authoritative post-run check as normal runs.
        /call GoToBazaarOnly
        /varcalc Runs ${Runs}+1
        /echo Finished resumed run #${Runs}. Re-checking the server's Adventure Stats in Bazaar now.
        /call RefreshProgressFromBazaar
        /goto :mainloop
    }

    | ---------- where am I starting? ----------
    /if (${Zone.ShortName.Equal[bazaar]}) {
        /echo Starting in the Bazaar: taking the map and heading to camp.
        /call MapPort
        /call ReturnToCamp
    }
    /if (${Zone.ShortName.NotEqual[${CampZone}]}) {
        /if (${Zone.ShortName.Equal[${LandZone}]} || ${ReturnPath.Find[${Zone.ShortName}]}) {
            /echo Starting in ${Zone.ShortName}: heading to camp.
            /call ReturnToCamp
        }
    }
    /if (${Zone.ShortName.NotEqual[${CampZone}]}) {
        /echo Starting in ${Zone.ShortName}: going to the Bazaar, then to camp.
        /call LeaveDungeon
        /call ReturnToCamp
    }
    /if (${Zone.ShortName.NotEqual[${CampZone}]}) {
        /echo Couldn't get to ${CampZone} (I'm in ${Zone.ShortName}). Ending.
        /endmacro
    }

    :mainloop
        /if (${SkipGet}) {
            /echo Skipping the adventure request for this loop (assuming the first entrance).
            /varset UseEnt2 FALSE
        } else {
            /call GetAdventure
        }
        /varset SkipGet FALSE
        /if (${HasCampSpot}) /call LeaveCamp
        /if (${UseEnt2}) {
            /call TravelPath ${Ent2Path}
        } else {
            /if (${MagusSay.NotEqual[none]}) /call UseMagus out
            | does nothing if the Magus already put us in the entrance zone
            /call TravelPath ${Ent1Path}
        }
        /call EnterDungeon
        /call ClearDungeon

        | Only a confirmed win counts toward the 10-success requirement.
        /if (!${AdvWon}) {
            /echo Adventure did not produce a success message. Not counting it toward camp progress.
        }

        | IMPORTANT: Do not trust an in-memory counter to decide the next camp.
        | After EVERY finished adventure, stop in Bazaar, re-read the real Adventure
        | Stats window, choose the first theme below 10, and only then travel onward.
        /call GoToBazaarOnly
        /varcalc Runs ${Runs}+1
        /echo Finished run #${Runs}. Re-checking the server's Adventure Stats in Bazaar now.
        /call RefreshProgressFromBazaar
    /goto :mainloop
/return

| ---------------------------------------------------------
| AUTHORITATIVE POST-RUN PROGRESS CHECK
| This sub must be called while standing in Bazaar. It re-reads the actual
| Adventure Stats from the client/server instead of trusting RunsInCamp.
| It then chooses SRO -> EP -> EC -> NRO -> BM based on the real totals.
| If all five are already 10+, SelectCampFromStats ends the macro here in Bazaar.
Sub RefreshProgressFromBazaar
    /declare OldCamp string local ${Camp}

    /if (${Zone.ShortName.NotEqual[bazaar]} && ${Zone.ShortName.NotEqual[ecommons]}) {
        /echo Progress refresh expected Bazaar or EC tunnel but I am in ${Zone.ShortName}. Ending rather than guessing counts.
        /endmacro
    }

    | Give the completed adventure a moment to be reflected in the stats window.
    /delay 5s
    /call ReadAdventureStats
    /call SelectCampFromStats

    /if (${Camp.NotEqual[${OldCamp}]}) {
        /echo Camp complete/change detected from REAL stats: [${OldCamp}] -> [${Camp}].
        /varset NeedRecruiterHail TRUE
    } else {
        /echo REAL stats say [${Camp}] is still current at ${RunsInCamp}/10 successes.
    }

    | Load settings for whichever camp the fresh stats selected.
    /varset Missing 0
    /call SetCamp
    /if (${MagusSay.Equal[none]}) /call CheckPath ${CampZone} ${Ent1Path}
    /if (${Ent2Names.NotEqual[none]}) /call CheckPath ${CampZone} ${Ent2Path}
    /call CheckPath ${LandZone} ${ReturnPath}
    /if (${Missing}) {
        /echo ${Missing} zone crossing(s) missing for selected camp [${Camp}]. Ending.
        /endmacro
    }

    /echo Fresh totals: SRO=${SRODone} EP=${EPDone} EC=${ECDone} NRO=${NRODone} BM=${BMDone}
    /echo Next required camp is [${Camp}] at ${RunsInCamp}/10.

    | Bazaar: use its map. EC tunnel: skip the map and go to the Magus/camp.
    /call MapPort
    /call ReturnToCamp
    /echo Arrived at [${Camp}] after refreshing Adventure Stats.
/return

| ---------------------------------------------------------
| Advance through the fixed camp order and travel there through the Bazaar.
Sub AdvanceCamp
    /declare OldCamp string local ${Camp}

    | Re-evaluate the stored success totals instead of blindly going to the
    | next camp. This skips any later theme that already has 10+ successes.
    /call SelectCampFromStats
    /if (${Camp.Equal[${OldCamp}]}) {
        /echo Camp [${OldCamp}] still selected after reaching 10; stopping to avoid a loop.
        /endmacro
    }

    /varset NeedRecruiterHail TRUE
    /varset Missing 0
    /call SetCamp

    | Validate the newly selected camp before travelling to it.
    /if (${MagusSay.Equal[none]}) /call CheckPath ${CampZone} ${Ent1Path}
    /if (${Ent2Names.NotEqual[none]}) /call CheckPath ${CampZone} ${Ent2Path}
    /call CheckPath ${LandZone} ${ReturnPath}
    /if (${Missing}) {
        /echo ${Missing} zone crossing(s) missing for next camp [${Camp}]. Ending.
        /endmacro
    }
    /echo Reached 10 successes at [${OldCamp}]. Next incomplete camp is [${Camp}] at ${RunsInCamp}/10.

    | We are standing at the previous camp. Bazaar and Back sends us to Bazaar,
    | then MapPort uses the NEW camp settings to send us toward the next recruiter.
    /call LeaveDungeon
    /call ReturnToCamp
    /echo Arrived at [${Camp}]. Current total is ${RunsInCamp}/10 successes.
/return

| ---------------------------------------------------------
| Open Alt+V -> View Stats and read the SUCCESS column from the five LDoN themes.
| AdventureStatsWnd uses AdvStats_ThemeList. Column 3 is Success.
Sub ReadAdventureStats
    /declare row int local 0

    | Alt+V opens the normal Adventure Window.
    /if (!${Window[AdventureRequestWnd].Open}) {
        /keypress alt+v
        /delay 8s ${Window[AdventureRequestWnd].Open}
    }
    /if (!${Window[AdventureRequestWnd].Open}) {
        /echo Could not open the Adventure Window with Alt+V. Ending rather than guessing camp progress.
        /endmacro
    }

    /notify AdventureRequestWnd AdvRqst_ViewStatsButton leftmouseup
    /delay 10s ${Window[AdventureStatsWnd].Open}
    /if (!${Window[AdventureStatsWnd].Open}) {
        /echo Could not open Adventure Stats. Ending rather than guessing camp progress.
        /endmacro
    }

    | Ask the server/client to refresh before reading values.
    /notify AdventureStatsWnd AdvStats_RefreshButton leftmouseup
    /delay 3s

    /varset row ${Window[AdventureStatsWnd].Child[AdvStats_ThemeList].List[Deepest,1]}
    /if (!${row}) {
        /echo Could not find Deepest Guk in Adventure Stats. Ending.
        /endmacro
    }
    /varset SRODone ${Window[AdventureStatsWnd].Child[AdvStats_ThemeList].List[${row},3]}

    /varset row ${Window[AdventureStatsWnd].Child[AdvStats_ThemeList].List[Miragul,1]}
    /if (!${row}) {
        /echo Could not find Miragul in Adventure Stats. Ending.
        /endmacro
    }
    /varset EPDone ${Window[AdventureStatsWnd].Child[AdvStats_ThemeList].List[${row},3]}

    /varset row ${Window[AdventureStatsWnd].Child[AdvStats_ThemeList].List[Rujarkian,1]}
    /if (!${row}) {
        /echo Could not find Rujarkian in Adventure Stats. Ending.
        /endmacro
    }
    /varset ECDone ${Window[AdventureStatsWnd].Child[AdvStats_ThemeList].List[${row},3]}

    /varset row ${Window[AdventureStatsWnd].Child[AdvStats_ThemeList].List[Takish,1]}
    /if (!${row}) {
        /echo Could not find Takish in Adventure Stats. Ending.
        /endmacro
    }
    /varset NRODone ${Window[AdventureStatsWnd].Child[AdvStats_ThemeList].List[${row},3]}

    /varset row ${Window[AdventureStatsWnd].Child[AdvStats_ThemeList].List[Mistmoore,1]}
    /if (!${row}) {
        /echo Could not find Mistmoore in Adventure Stats. Ending.
        /endmacro
    }
    /varset BMDone ${Window[AdventureStatsWnd].Child[AdvStats_ThemeList].List[${row},3]}

    /echo LDoN successes: SRO=${SRODone}, EP=${EPDone}, EC=${ECDone}, NRO=${NRODone}, BM=${BMDone}

    /notify AdventureStatsWnd AdvStats_DoneButton leftmouseup
    /delay 2s !${Window[AdventureStatsWnd].Open}
    | Close the Adventure Window too so GetAdventure starts with a clean window.
    /if (${Window[AdventureRequestWnd].Open}) {
        /keypress ESC
        /delay 2s !${Window[AdventureRequestWnd].Open}
    }
/return

| ---------------------------------------------------------
| STRICT, GATED CAMP ORDER -- NEVER SKIP A REQUIRED EARLIER CAMP.
| Progression is always:
|   SRO 10 -> EP/EF 10 -> EC 10 -> NRO 10 -> BM 10 -> STOP
|
| A later camp is not eligible until every camp before it has reached 10.
| This intentionally does NOT choose a later camp merely because it is below 10.
Sub SelectCampFromStats
    | Gate 1: SRO must be completed first.
    /if (${SRODone}<10) {
        /varset Camp sro
        /varset RunsInCamp ${SRODone}
        /return
    }

    | Gate 2: only after SRO is complete may EP/EF run.
    /if (${SRODone}>=10 && ${EPDone}<10) {
        /varset Camp ep
        /varset RunsInCamp ${EPDone}
        /return
    }

    | Gate 3: only after SRO and EP/EF are complete may EC run.
    /if (${SRODone}>=10 && ${EPDone}>=10 && ${ECDone}<10) {
        /varset Camp ec
        /varset RunsInCamp ${ECDone}
        /return
    }

    | Gate 4: only after SRO, EP/EF, and EC are complete may NRO run.
    /if (${SRODone}>=10 && ${EPDone}>=10 && ${ECDone}>=10 && ${NRODone}<10) {
        /varset Camp nro
        /varset RunsInCamp ${NRODone}
        /return
    }

    | Gate 5: BM is last and cannot run until all four earlier camps are complete.
    /if (${SRODone}>=10 && ${EPDone}>=10 && ${ECDone}>=10 && ${NRODone}>=10 && ${BMDone}<10) {
        /varset Camp bm
        /varset RunsInCamp ${BMDone}
        /return
    }

    /echo ==================================================
    /echo All five LDoN themes have reached the required 10 successes IN ORDER.
    /echo SRO=${SRODone} EP=${EPDone} EC=${ECDone} NRO=${NRODone} BM=${BMDone}
    /echo Nothing left to run. Stopping macro at the Bazaar/EC tunnel landing.
    /echo ==================================================
    /endmacro
/return

| ---------------------------------------------------------
| Keep the startup totals in sync after each confirmed success.
Sub UpdateStoredSuccess
    /if (${Camp.Equal[sro]}) /varset SRODone ${RunsInCamp}
    /if (${Camp.Equal[ep]})  /varset EPDone  ${RunsInCamp}
    /if (${Camp.Equal[ec]})  /varset ECDone  ${RunsInCamp}
    /if (${Camp.Equal[nro]}) /varset NRODone ${RunsInCamp}
    /if (${Camp.Equal[bm]})  /varset BMDone  ${RunsInCamp}
/return

| ---------------------------------------------------------
| REQUIRED FIRST-CAMP HAIL:
| Whenever a camp first becomes current for this macro run, hail that camp's
| Adventure Recruiter once BEFORE requesting the first mission from that camp.
| NeedRecruiterHail is reset to TRUE whenever the strict camp sequence advances.
Sub HailRecruiter(int npcID)
    /if (!${npcID}) /return FALSE
    | Target acquisition can lag behind /target, especially just after moving.
    | Never send HAIL until the requested recruiter's ID is actually selected.
    /target clear
    /delay 5
    /target id ${npcID}
    /delay 5s ${Target.ID}==${npcID}
    /if (${Target.ID}!=${npcID}) {
        /echo Recruiter target not ready for ${QuestNPC}; hail will retry.
        /return FALSE
    }
    /delay 10
    /face fast
    /delay 5
    /if (${Target.ID}!=${npcID}) /return FALSE
    /keypress HAIL
    /delay 3s
    /echo Hailed recruiter ${QuestNPC} for camp [${Camp}].
/return TRUE

| ---------------------------------------------------------
Sub ParseArg(string a)
    /if (!${Defined[a]}) /return
    /if (!${a.Length} || ${a.Equal[NULL]}) /return
    /if (${a.Equal[skip]}) {
        /varset SkipGet TRUE
    } else /if (${a.Equal[resume]}) {
        /varset ResumeDungeon TRUE
    } else {
        /varset Camp ${a}
    }
/return

| ---------------------------------------------------------
| ================= PER-CAMP CONFIG =================
| Paths are zone short names in travel order, separated by |  (none = same zone)
| Ent2 is only used when the adventure's name is in Ent2Names.
| MapRow, if set, picks the waypoint by its position in the list instead of by name.
| MagusSay, if set, is said to the camp's Magus to port to the first entrance's zone.
| RetMagusSay, if set, is said to the Magus in the landing zone to port to the camp.
| An entrance Z of none means "let nav work out the height".
| An entrance Door is the switch ID to click (0 = nearest switch).
Sub SetCamp
    | Reset all per-camp values first. This matters when the macro changes camps
    | without restarting, otherwise settings from the previous camp can carry over.
    /varset CampZone     none
    /varset QuestNPC     none
    /varset HasCampSpot  FALSE
    /varset CampY        0
    /varset CampX        0
    /varset CampZ        0
    /varset Ent1Zone     none
    /varset Ent1Path     none
    /varset Ent1Y        0
    /varset Ent1X        0
    /varset Ent1Z        none
    /varset Ent1Door     0
    /varset MagusSay     none
    /varset MagusName    Magus
    /varset HasMagusExit FALSE
    /varset MagusExitY   0
    /varset MagusExitX   0
    /varset Ent2Names    none
    /varset Ent2Zone     none
    /varset Ent2Path     none
    /varset Ent2Y        0
    /varset Ent2X        0
    /varset Ent2Z        none
    /varset Ent2Door     0
    /varset MapContinent 0
    /varset MapWaypoint  none
    /varset MapRow       0
    /varset LandZone     none
    /varset ReturnPath   none
    /varset RetMagusSay  none
    /varset RetMagusName Magus

    /if (${Camp.Equal[sro]}) {
        | Deepest Guk
        /varset CampZone     sro
        /varset QuestNPC     Kallei Ribblok
        /varset HasCampSpot  TRUE
        /varset CampY        -1497.2
        /varset CampX        998.3
        /varset CampZ        -23.2
        /varset Ent1Zone     guktop
        /varset Ent1Path     innothule|guktop
        /varset Ent1Y        438.1
        /varset Ent1X        224.2
        /varset Ent1Z        -9.2
        /varset Ent2Names    Cauldron of Lost Souls
        /varset Ent2Zone     innothule
        /varset Ent2Path     innothule
        /varset Ent2Y        1353
        /varset Ent2X        1186
        | Trip back: East Commonlands waypoint, then Magus Zeir ports to South Ro
        /varset MapContinent 1
        /varset MapWaypoint  East Commonlands
        /varset LandZone     ecommons
        /varset ReturnPath   none
        /varset RetMagusSay  South Ro
        /varset RetMagusName Magus Zeir
        /return
    }
    /if (${Camp.Equal[ep]}) {
        | Miragul's Menagerie - both entrances are in Everfrost itself
        /varset CampZone     everfrost
        /varset QuestNPC     Mannis McGuyett
        /varset Ent1Zone     everfrost
        /varset Ent1Y        -828
        /varset Ent1X        -5458
        /varset Ent2Names    Hushed Banquet|Heart of the Menagerie
        /varset Ent2Zone     everfrost
        /varset Ent2Y        2771
        /varset Ent2X        -4725
        | Trip back: always use East Commonlands as the hub, then Magus Zeir to Everfrost
        /varset MapContinent 1
        /varset MapWaypoint  East Commonlands
        /varset LandZone     ecommons
        /varset ReturnPath   none
        /varset RetMagusSay  Everfrost
        /varset RetMagusName Magus Zeir
        /return
    }
    /if (${Camp.Equal[bm]}) {
        | Mistmoore's Catacombs - entrances are in Lesser Faydark
        /varset CampZone     butcher
        /varset QuestNPC     Xyzelauna
        /varset Ent1Zone     lfaydark
        /varset Ent1Path     gfaydark|lfaydark
        /varset Ent1Y        -759.1
        /varset Ent1X        3832.8
        /varset Ent1Z        2.5
        /varset Ent1Door     7
        /varset Ent2Names    Dreary Grotto|Cesspits of Putrescence
        /varset Ent2Zone     lfaydark
        /varset Ent2Path     gfaydark|lfaydark
        /varset Ent2Y        -111.0
        /varset Ent2X        3861.8
        /varset Ent2Z        -39.6
        /varset Ent2Door     10
        | Trip back: East Commonlands waypoint, then the Magus there ports to this camp
        /varset MapContinent 1
        /varset MapWaypoint  East Commonlands
        /varset LandZone     ecommons
        /varset RetMagusSay  Butcherblock
        /varset RetMagusName Magus Zeir
        /return
    }
    /if (${Camp.Equal[ec]}) {
        | Rujarkian Hills - entrance is in South Ro
        /varset CampZone     ecommons
        /varset QuestNPC     Periac Windfell
        /varset Ent1Zone     sro
        /varset Ent1Path     nro|oasis|sro
        | Shortcut: say this to the Magus at the camp to port to the entrance zone.
        | To go back to running Ent1Path, put a | at the start of the next line.
        /varset MagusSay     South Ro
        /varset MagusName    Magus Zeir
        | after the port, walk straight to this clear spot before using nav (tents)
        /varset HasMagusExit TRUE
        /varset MagusExitY   -1458.2
        /varset MagusExitX   1069.9
        /varset Ent1Y        -2111.9
        /varset Ent1X        1331.6
        /varset Ent1Z        -68.3
        | switch 1 = RUJPORTAL701 (switch 6, HUT1, is just a hut next to it)
        /varset Ent1Door     1
        | Antonica, the "East Commonlands" waypoint (found by name)
        /varset MapContinent 1
        /varset MapWaypoint  East Commonlands
        /varset LandZone     ecommons
        /return
    }
    /if (${Camp.Equal[nro]}) {
        | Takish-Hiz - entrance is in North Ro itself
        /varset CampZone     nro
        /varset QuestNPC     Escon Quickbow
        /varset Ent1Zone     nro
        /varset Ent1Y        -956.2
        /varset Ent1X        119.7
        /varset Ent1Z        -61.4
        /varset Ent1Door     3
        | Trip back: East Commonlands waypoint, then the Magus there ports to this camp
        /varset MapContinent 1
        /varset MapWaypoint  East Commonlands
        /varset LandZone     ecommons
        /varset RetMagusSay  North Ro
        /varset RetMagusName Magus Zeir
        /return
    }
    /echo Unknown camp [${Camp}]. Use one of: sro ep bm ec nro
    /endmacro
/return

| ---------------------------------------------------------
| Report any zone crossing on this path that hasn't been recorded
Sub CheckPath(string fromZone, string path)
    /if (${path.Equal[none]}) /return
    /declare i    int    local 1
    /declare prev string local ${fromZone}
    /declare z    string local
    :hop
    /varset z ${path.Arg[${i},|]}
    /if (${z.Length} && ${z.NotEqual[NULL]}) {
        /call LoadRoute ${prev}_to_${z}
        /if (${RCount}<2) {
            /echo Missing zone crossing: ${prev}_to_${z} is not built in (see Sub BuiltInRoute).
            /varcalc Missing ${Missing}+1
        }
        /varset prev ${z}
        /varcalc i ${i}+1
        /goto :hop
    }
/return

| ---------------------------------------------------------
| Travel through a list of zones, one crossing at a time
Sub TravelPath(string path)
    /if (${path.Equal[none]}) /return
    /declare i     int    local 1
    /declare first int    local 1
    /declare z     string local

    | if I'm already in one of the zones on the path, continue from there
    :find
    /varset z ${path.Arg[${i},|]}
    /if (${z.Length} && ${z.NotEqual[NULL]}) {
        /if (${Zone.ShortName.Equal[${z}]}) /varcalc first ${i}+1
        /varcalc i ${i}+1
        /goto :find
    }

    /varset i ${first}
    :hop
    /varset z ${path.Arg[${i},|]}
    /if (${z.Length} && ${z.NotEqual[NULL]}) {
        /call RunRoute ${Zone.ShortName}_to_${z}
        /varcalc i ${i}+1
        /goto :hop
    }
/return
    /declare i int    local 1
    /declare z string local
    :hop
    /varset z ${path.Arg[${i},|]}
    /if (${z.Length} && ${z.NotEqual[NULL]}) {
        /if (${Zone.ShortName.NotEqual[${z}]}) /call RunRoute ${Zone.ShortName}_to_${z}
        /varcalc i ${i}+1
        /goto :hop
    }
/return

| ---------------------------------------------------------
| Load a route into RP[] / RCount / RZone / RZoned / RHeading / RLastZ.
| Built-in routes come first; anything else is read from ldon_paths.ini if present.
Sub LoadRoute(string route)
    /declare i int local 1
    /varset RCount   0
    /varset RBuiltIn FALSE
    /call BuiltInRoute ${route}
    /if (${RCount}) /return

    /varset RCount   ${Ini[${PathFile},${route},Count,0]}
    /if (${RCount}>300) /varset RCount 300
    /varset RZoned   ${Ini[${PathFile},${route},Zoned,0]}
    /varset RZone    ${Ini[${PathFile},${route},Zone,none]}
    /varset RHeading ${Ini[${PathFile},${route},Heading,0]}
    /varset RLastZ   ${Ini[${PathFile},${route},LastZ,NONE]}
    :load
    /if (${i}<=${RCount}) {
        /varset RP[${i}] ${Ini[${PathFile},${route},${i}]}
        /varcalc i ${i}+1
        /goto :load
    }
/return

| ---------------------------------------------------------
| ================= BUILT-IN ZONE CROSSINGS =================
| Taken from recorded runs: the last few points before the
| zone line, the height there, and the heading used to run across.
| To change one, edit its points, height and heading here.
Sub BuiltInRoute(string route)
    /if (${route.Equal[sro_to_innothule]}) {
        /varset RZone    sro
        /varset RZoned   1
        /varset RHeading 114.95
